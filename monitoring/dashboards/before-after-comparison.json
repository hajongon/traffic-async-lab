{
  "title": "동기 통신 버전 vs 비동기 통신으로 개선한 버전",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "panels": [
    {
      "type": "timeseries",
      "title": "HTTP request p95",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {"expr": "histogram_quantile(0.95, sum by (le, job) (rate(http_server_requests_seconds_bucket[1m])))", "legendFormat": "{{job}}"}
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP request rate",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {"expr": "sum by (job) (rate(http_server_requests_seconds_count[1m]))", "legendFormat": "{{job}}"}
      ]
    }
  ]
}
